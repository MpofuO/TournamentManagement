						"body": {
							"mode": "raw",
							"raw": "{\n\t\"teams\": [\n\t\t{ \"nameAbbreviation\": \"Falcons-FAL\" },\n\t\t{ \"nameAbbreviation\": \"Tigers-TIG\" },\n\t\t{ \"nameAbbreviation\": \"Lions-LIO\" },\n\t\t{ \"nameAbbreviation\": \"Eagles-EAG\" }\n\t]\n}",
