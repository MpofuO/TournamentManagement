					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"teamName\": \"Falcons\",\n\t\"abbreviation\": \"FAL\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url}}/api/teams",
							"host": [
								"{{url}}"
							],
							"path": [
								"api",
								"teams"
							]
						},
						"description": "TeamsController.CreateTeam. Body: teamName (1-40 English letters/spaces, at least one letter) and abbreviation (exactly 3 English letters). Returns the created TeamDto including teamId. Duplicate name/abbreviation returns 400; database unique-index conflict returns 409."
					},
					"response": []
				},
